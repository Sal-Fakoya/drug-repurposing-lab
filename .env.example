# Copy to .env. Never commit .env.
LAB_MODE=toy              # toy = synthetic offline data, real = Thierry's loaders
CUTOFF_YEAR=2015
LAB_BUDGET=20             # experiment cost units
LAB_SEED=0
LAB_METHOD_B_INCLUDE_HHV8=1  # 0 = method B ignores records mentioning HHV-8, KSHV, Kaposi or HIV
# LAB_TARGET_DRUG=        # masked id of the target drug, used for evaluation only (real mode)
