{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledger row (envelope)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "synthetic": {
      "type": "boolean",
      "description": "True when written in toy mode."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "ts",
    "payload"
  ]
}
