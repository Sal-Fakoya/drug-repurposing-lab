{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verdict",
  "type": "object",
  "properties": {
    "res_id": {
      "type": "string"
    },
    "hyp_id": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "supported",
        "weakened",
        "contested"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "string"
    },
    "predicted_direction": {
      "enum": [
        "enriched",
        "not_enriched"
      ],
      "description": "What methods A and B should measure for the hypothesis's gene sets."
    },
    "z": {
      "type": "number"
    },
    "prior_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "new_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "update_id": {
      "type": "string"
    }
  },
  "required": [
    "res_id",
    "hyp_id",
    "verdict",
    "explanation",
    "evidence_ids",
    "uncertainty"
  ],
  "additionalProperties": false
}
