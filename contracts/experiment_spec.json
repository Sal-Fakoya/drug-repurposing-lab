{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment spec",
  "type": "object",
  "properties": {
    "hyp_id": {
      "type": "string"
    },
    "method": {
      "enum": [
        "A",
        "B"
      ]
    },
    "arm_id": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "expected_cost": {
      "type": "number"
    },
    "expected_learning": {
      "type": "number"
    },
    "feasibility": {
      "type": "number"
    },
    "status": {
      "enum": [
        "planned",
        "run",
        "superseded"
      ]
    },
    "seed": {
      "type": "integer",
      "description": "Tie-break seed run_experiment must use and record."
    },
    "control": {
      "type": "boolean",
      "description": "True for the fixed negative-control gene set."
    }
  },
  "required": [
    "hyp_id",
    "method",
    "arm_id",
    "params",
    "expected_cost",
    "expected_learning",
    "feasibility"
  ],
  "additionalProperties": false
}
