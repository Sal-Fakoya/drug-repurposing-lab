{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hypothesis",
  "type": "object",
  "properties": {
    "claim": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "label": {
      "const": "agent-generated"
    },
    "status": {
      "enum": [
        "active",
        "contested",
        "retired"
      ]
    },
    "gene_set_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "claim",
    "evidence_ids",
    "confidence",
    "label",
    "status",
    "gene_set_ids"
  ],
  "additionalProperties": false
}
