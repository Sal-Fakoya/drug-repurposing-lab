{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment update",
  "type": "object",
  "properties": {
    "exp_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "run",
        "superseded"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "exp_id",
    "status"
  ],
  "additionalProperties": false
}
