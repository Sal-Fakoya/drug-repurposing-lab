{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence record",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "pmid": {
      "type": [
        "string",
        "null"
      ]
    },
    "pub_date": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "snippet": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieved_at": {
      "type": "string"
    },
    "abstract": {
      "type": "string",
      "description": "Full abstract (Europe PMC abstractText)."
    },
    "hhv8_status": {
      "enum": [
        "positive",
        "negated_only",
        "none"
      ],
      "description": "positive: HHV-8, KSHV, Kaposi or HIV discussed as present or causal; negated_only: every mention is a negation (e.g. HHV-8-negative); none: no mention. See lab/hhv8.py."
    },
    "hhv8_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every term mentioned, negated or not."
    }
  },
  "required": [
    "source",
    "pub_date",
    "title",
    "snippet",
    "entities",
    "retrieved_at"
  ],
  "additionalProperties": false
}
